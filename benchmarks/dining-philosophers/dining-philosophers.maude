fmod DINING-PHILOSOPHERS-BASE is
  protecting NAT .
  sorts Status .
  ops think hungry single eat : -> Status [ctor] .

  --- focus parameter domain (shared by enabled predicates and action recording)
  sort Nat? .  subsort Nat < Nat? .
  op * : -> Nat? [ctor] .

  op #N : ~> Nat .  --- total number of philosophers
  vars I J : Nat .

  ops lc rc : Nat ~> Nat .
  eq lc(I) = I .
  ceq rc(I) = s(I) if (s(I) < #N) = true .
  ceq rc(I) = 0 if (s(I) == #N) = true .

  op adj : Nat Nat ~> Bool .
  eq adj(I,J) = (J == lc(I)) or (J == rc(I)) .

  sorts Conf Phil Chop .
  subsorts Phil Chop < Conf .

  op p : Nat Status -> Phil [ctor] .
  op c : Nat -> Chop [ctor] .

  op none : -> Conf [ctor] .
  op _||_ : Conf Conf -> Conf [ctor comm assoc id: none] .
endfm

mod N-DINING-PHILOSOPHERS is
  including DINING-PHILOSOPHERS-BASE .

  vars I J : Nat .	var C : Conf .	

  *** defining the system behavior with localized fairness

  rl [th]: p(I,think) => p(I,hungry) .

 crl [hs]: p(I,hungry) || c(J) => p(I,single)
   if adj(I,J) = true .

 crl [se]: p(I,single) || c(J) => p(I,eat) 
   if adj(I,J) = true .

  rl [et]: p(I,eat) => p(I,think) || c(lc(I)) || c(rc(I)) .
endm

fmod DINING-PHILOSOPHERS-EXEC is
  including DINING-PHILOSOPHERS-BASE .
  sort RuleLabel .
  ops th hs se et : -> RuleLabel [ctor] .
  sort Action .
  op noAct : -> Action [ctor] .
  op exec : RuleLabel Nat? -> Action [ctor] .
endfm

mod N-DINING-PHILOSOPHERS2 is
  including DINING-PHILOSOPHERS-EXEC .

  vars I J : Nat .  var C : Conf .  var ACT : Action .

  sort Top .
  op {_|_} : Conf Action -> Top [ctor] .

  rl [th]: {p(I,think) || C | ACT} => {p(I,hungry) || C | exec(th,I)} .

 crl [hs]: {p(I,hungry) || c(J) || C | ACT} => {p(I,single) || C | exec(hs,I)}
   if adj(I,J) = true .

 crl [se]: {p(I,single) || c(J) || C | ACT} => {p(I,eat) || C | exec(se,I)}
   if adj(I,J) = true .

  rl [et]: {p(I,eat) || C | ACT} => {p(I,think) || c(lc(I)) || c(rc(I)) || C | exec(et,I)} .
endm
