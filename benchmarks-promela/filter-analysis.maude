*** RL analysis layer for the 2-proc PROMELA filter/Peterson mutex model.
*** Goal = someInCS (reachable: a process enters its critical section).
*** Loc layout (from filter-2procs): flag0=0, flag1=1, turn=2, in0=3, in1=4.

load ../semantics/promela-agcel.maude .

mod MODEL is
  protecting PROMELA-AGCEL .
  subsort GlobalState < State .

  var S : State .
  var CFG : KConfig .
  var STR : Map{Nat, PROMELA-Value} .
  vars FV FV' : FeatVec .

  --- goal: at least one process is in its critical section (in0 or in1 set)
  op someInCS : -> Prop [ctor] .
  eq ([ store((3 |-> # 1, STR)) CFG ]) |= someInCS = true .
  eq ([ store((4 |-> # 1, STR)) CFG ]) |= someInCS = true .
  eq S |= someInCS = false [owise] .

  eq obs(S) = < obsUpto(S,
    varEq('flag0, 0, 1) ; varEq('flag1, 1, 1) ; varEq('turn, 2, 1) ;
    varEq('in0, 3, 1) ; varEq('in1, 4, 1) ; allDone ; someInCS) > .

  eq reward(< FV , (someInCS : true) , FV' >) = 1.0 .
  eq reward(MS:MDPState) = 0.0 [owise] .
endm


mod FILTER-PROMELA-TEST is
  pr MODEL .
  op goal : -> Prop .
  eq goal = someInCS .

  op env0 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  op env1 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  eq env0 = ((lval('flag0, 0) |-> loc(0)), (lval('flag1, 0) |-> loc(1)),
             (lval('turn, 0) |-> loc(2)),
             (lval('in0, 0) |-> loc(3)), (lval('in1, 0) |-> loc(4))) .
  eq env1 = env0 .

  op body0 : -> Seq .
  op body1 : -> Seq .
  eq body0 = ( ('flag0 = # 1) ; ('turn = # 1) ;
               (('flag1 == # 0) || ('turn == # 0)) ;
               ('in0 = # 1) ; ('in0 = # 0) ; ('flag0 = # 0) ; .Decls ) .
  eq body1 = ( ('flag1 = # 1) ; ('turn = # 0) ;
               (('flag0 == # 0) || ('turn == # 1)) ;
               ('in1 = # 1) ; ('in1 = # 0) ; ('flag1 = # 0) ; .Decls ) .

  op init : -> GlobalState .
  eq init = [
    proctypes(none)
    procs(
      proc(pid(0) name('P0) k( body0 ~> .K ) local(nil) env(env0))
      proc(pid(1) name('P1) k( body1 ~> .K ) local(nil) env(env1)) )
    store(((0 |-> # 0), (1 |-> # 0), (2 |-> # 0), (3 |-> # 0), (4 |-> # 0)))
    network(empty) lock(#none) active(0 1)
    nextLoc(5) nextPid(2) nextBCid(0) nextHCid(0) ] .
endm
