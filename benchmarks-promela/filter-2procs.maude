*** Filter/Peterson mutual exclusion, 2 processes (hand-built post-INIT [...] state).
*** Property: mutual exclusion -- never both processes in the critical section.
*** Expected: bothInCS => No solution ; someInCS => solution (reachability control).
*** Backend: no atomic{} (each statement its own step) => [loose]-robust, safety result valid.

load ../semantics/promela-semantics.maude .

fmod BENCH-PROPS-FILTER is
  protecting PROMELA-CONFIG .
  protecting BOOL .
  op bothInCS : GlobalState -> Bool .
  op someInCS : GlobalState -> Bool .
  eq bothInCS([store((3 |-> # 1, 4 |-> # 1, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq bothInCS(C:GlobalState) = false [owise] .
  eq someInCS([store((3 |-> # 1, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq someInCS([store((4 |-> # 1, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq someInCS(C:GlobalState) = false [owise] .
endfm

mod BENCH-FILTER2 is
  protecting PROMELA-SEMANTICS .
  protecting BENCH-PROPS-FILTER .

  op env0 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  op env1 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  eq env0 = ((lval('flag0, 0) |-> loc(0)), (lval('flag1, 0) |-> loc(1)),
             (lval('turn, 0) |-> loc(2)),
             (lval('in0, 0) |-> loc(3)), (lval('in1, 0) |-> loc(4))) .
  eq env1 = env0 .

  op body0 : -> Seq .
  op body1 : -> Seq .
  eq body0 = ( ('flag0 = # 1) ; ('turn = # 1) ;
               (('flag1 == # 0) || ('turn == # 0)) ;
               ('in0 = # 1) ; ('in0 = # 0) ; ('flag0 = # 0) ; .Decls ) .
  eq body1 = ( ('flag1 = # 1) ; ('turn = # 0) ;
               (('flag0 == # 0) || ('turn == # 1)) ;
               ('in1 = # 1) ; ('in1 = # 0) ; ('flag1 = # 0) ; .Decls ) .

  op init : -> GlobalState .
  eq init = [
    proctypes(none)
    procs(
      proc(pid(0) name('P0) k( body0 ~> .K ) local(nil) env(env0))
      proc(pid(1) name('P1) k( body1 ~> .K ) local(nil) env(env1)) )
    store(((0 |-> # 0), (1 |-> # 0), (2 |-> # 0), (3 |-> # 0), (4 |-> # 0)))
    network(empty) lock(#none) active(0 1)
    nextLoc(5) nextPid(2) nextBCid(0) nextHCid(0) ] .
endm

search init =>* C:GlobalState such that bothInCS(C:GlobalState) .
search init =>* C:GlobalState such that someInCS(C:GlobalState) .
