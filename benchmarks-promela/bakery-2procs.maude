*** Bakery mutual exclusion, 2 processes (hand-built post-INIT [...]; one cycle/proc, bounded).
*** Property: mutual exclusion -- crit counter never reaches 2.
*** Expected: mutexViolated => No solution ; someInCrit => solution (reachability control).
*** Both hold. mutexViolated depends on the atomic blocks: it had spurious solutions while
*** [loose] could fire at any time and a statement loaded inside a block lost the atomic context.

load ../semantics/promela-semantics.maude .

fmod BENCH-PROPS-BAKERY2 is
  protecting PROMELA-CONFIG .
  protecting BOOL .
  op mutexViolated : GlobalState -> Bool .
  op someInCrit : GlobalState -> Bool .
  ceq mutexViolated([store((2 |-> # N:Int, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true if N:Int >= 2 .
  eq mutexViolated(C:GlobalState) = false [owise] .
  eq someInCrit([store((2 |-> # 1, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq someInCrit(C:GlobalState) = false [owise] .
endfm

mod BENCH-BAKERY2 is
  protecting PROMELA-SEMANTICS .
  protecting BENCH-PROPS-BAKERY2 .

  op env0 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  op env1 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  eq env0 = ((lval('disp, 0) |-> loc(0)), (lval('serv, 0) |-> loc(1)),
             (lval('crit, 0) |-> loc(2)), (lval('tick, 0) |-> loc(3))) .
  eq env1 = ((lval('disp, 0) |-> loc(0)), (lval('serv, 0) |-> loc(1)),
             (lval('crit, 0) |-> loc(2)), (lval('tick, 0) |-> loc(4))) .

  op CYCLE : -> Seq .
  eq CYCLE = ( atomic{ ('tick = 'disp) ; ('disp = 'disp + # 1) ; .Decls } ;
               atomic{ ('tick == 'serv) ; ('crit = 'crit + # 1) ; .Decls } ;
               atomic{ ('serv = 'serv + # 1) ; ('crit = 'crit - # 1) ; .Decls } ;
               .Decls ) .

  op init : -> GlobalState .
  eq init = [
    proctypes(none)
    procs(
      proc(pid(0) name('P0) k( CYCLE ~> .K ) local(nil) env(env0))
      proc(pid(1) name('P1) k( CYCLE ~> .K ) local(nil) env(env1)) )
    store(((0 |-> # 0), (1 |-> # 0), (2 |-> # 0), (3 |-> # 0), (4 |-> # 0)))
    network(empty) lock(#none) active(0 1)
    nextLoc(5) nextPid(2) nextBCid(0) nextHCid(0) ] .
endm

search init =>* C:GlobalState such that mutexViolated(C:GlobalState) .
search init =>* C:GlobalState such that someInCrit(C:GlobalState) .
