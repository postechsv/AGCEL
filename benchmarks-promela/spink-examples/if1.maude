*** if1.pml: nondeterministic if, 1 proc (hand-built post-INIT [...]).
*** if :: x:=1 :: x:=2 fi.
*** Expected: xIs1 => solution ; xIs2 => solution (both branches reachable).
*** Constructs: nondeterministic if.

load ../../semantics/promela-semantics.maude .

fmod BENCH-PROPS-IF1 is
  protecting PROMELA-CONFIG . protecting BOOL .
  op xIs1 : GlobalState -> Bool .   op xIs2 : GlobalState -> Bool .
  eq xIs1([store((0 |-> # 1, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq xIs1(C:GlobalState) = false [owise] .
  eq xIs2([store((0 |-> # 2, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq xIs2(C:GlobalState) = false [owise] .
endfm

mod BENCH-IF1 is
  protecting PROMELA-SEMANTICS . protecting BENCH-PROPS-IF1 .
  op env0 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  eq env0 = (lval('x, 0) |-> loc(0)) .
  op body0 : -> Seq .
  eq body0 = ( if (:: ('x = # 1) ; .Decls) (:: ('x = # 2) ; .Decls) fi ) ; .Decls .
  op init : -> GlobalState .
  eq init = [ proctypes(none)
    procs(proc(pid(0) name('P0) k( body0 ~> .K ) local(nil) env(env0)))
    store(0 |-> # 0) network(empty) lock(#none) active(0)
    nextLoc(1) nextPid(1) nextBCid(0) nextHCid(0) ] .
endm

search init =>* C:GlobalState such that xIs1(C:GlobalState) .
search init =>* C:GlobalState such that xIs2(C:GlobalState) .
