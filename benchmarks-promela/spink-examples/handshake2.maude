*** handshake2.pml: rendezvous multi-field, 2 procs (hand-built post-INIT [...]).
*** P0 sends (42,43) on handshake chan; P1 receives into x[0],x[1].
*** Expected: xOK => solution (x[0]=42, x[1]=43).
*** Constructs: handshake channel, multi-field rendezvous.

load ../../semantics/promela-semantics.maude .

fmod BENCH-PROPS-HANDSHAKE2 is
  protecting PROMELA-CONFIG . protecting BOOL .
  op xOK : GlobalState -> Bool .
  eq xOK([store((0 |-> # 42, 1 |-> # 43, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq xOK(C:GlobalState) = false [owise] .
endfm

mod BENCH-HANDSHAKE2 is
  protecting PROMELA-SEMANTICS . protecting BENCH-PROPS-HANDSHAKE2 .
  op env0 : -> Map{PROMELA-LVal, PROMELA-Ref} .  op env1 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  eq env0 = (lval('c, 0) |-> hs(0)) .
  eq env1 = ((lval('c, 0) |-> hs(0)), (lval('x, 0) |-> loc(0)), (lval('x, 1) |-> loc(1))) .
  op body0 : -> Seq .  op body1 : -> Seq .
  eq body0 = ( ('c[# 0] ! (# 42, # 43)) ; .Decls ) .   eq body1 = ( ('c[# 0] ? ('x[# 0], 'x[# 1])) ; .Decls ) .
  op init : -> GlobalState .
  eq init = [ proctypes(none)
    procs(proc(pid(0) name('P0) k( body0 ~> .K ) local(nil) env(env0))
          proc(pid(1) name('P1) k( body1 ~> .K ) local(nil) env(env1)))
    store(((0 |-> # 0), (1 |-> # 0))) network(empty) lock(#none) active(0 1)
    nextLoc(2) nextPid(2) nextBCid(0) nextHCid(1) ] .
endm

search init =>* C:GlobalState such that xOK(C:GlobalState) .
