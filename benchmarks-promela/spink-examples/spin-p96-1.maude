*** spin-p96.1.pml: guard race + arith, 2 procs (hand-built post-INIT [...]).
*** both guard state==1; whichever fires first updates; final state in {0,1,2}.
*** Expected: stateIs0, stateIs1, stateIs2 => all solution.
*** Constructs: shared var, guard race.

load ../../semantics/promela-semantics.maude .

fmod BENCH-PROPS-SPIN-P96-1 is
  protecting PROMELA-CONFIG . protecting BOOL .
  op stateIs0 : GlobalState -> Bool .  op stateIs1 : GlobalState -> Bool .  op stateIs2 : GlobalState -> Bool .
  eq stateIs0([store((0 |-> # 0, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq stateIs0(C:GlobalState) = false [owise] .
  eq stateIs1([store((0 |-> # 1, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq stateIs1(C:GlobalState) = false [owise] .
  eq stateIs2([store((0 |-> # 2, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq stateIs2(C:GlobalState) = false [owise] .
endfm

mod BENCH-SPIN-P96-1 is
  protecting PROMELA-SEMANTICS . protecting BENCH-PROPS-SPIN-P96-1 .
  op env0 : -> Map{PROMELA-LVal, PROMELA-Ref} .  op env1 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  eq env0 = (lval('state, 0) |-> loc(0)) .  eq env1 = env0 .
  op body0 : -> Seq .  op body1 : -> Seq .
  eq body0 = ( ('state == # 1) ; ('state = 'state + # 1) ; .Decls ) .
  eq body1 = ( ('state == # 1) ; ('state = 'state - # 1) ; .Decls ) .
  op init : -> GlobalState .
  eq init = [ proctypes(none)
    procs(proc(pid(0) name('A) k( body0 ~> .K ) local(nil) env(env0))
          proc(pid(1) name('B) k( body1 ~> .K ) local(nil) env(env1)))
    store(0 |-> # 1) network(empty) lock(#none) active(0 1)
    nextLoc(1) nextPid(2) nextBCid(0) nextHCid(0) ] .
endm

search init =>* C:GlobalState such that stateIs0(C:GlobalState) .
search init =>* C:GlobalState such that stateIs1(C:GlobalState) .
search init =>* C:GlobalState such that stateIs2(C:GlobalState) .
