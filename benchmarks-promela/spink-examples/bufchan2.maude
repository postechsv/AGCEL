*** bufchan2.pml: buffered channel full-block, 1 proc (hand-built post-INIT [...]).
*** send to a full (cap 3) channel blocks; 4th send stuck.
*** Expected (rew): network 0 |-> mq(3, (m(# 42), m(# 43), m(# 44))), k stuck at 'c ! # 45.
*** Constructs: buffered channel, [send-push], capacity blocking.

load ../../semantics/promela-semantics.maude .

mod BENCH-BUFCHAN2 is
  protecting PROMELA-SEMANTICS .
  op env0 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  eq env0 = (lval('c, 0) |-> ch(0)) .
  op body0 : -> Seq .
  eq body0 = ( ('c ! # 42) ; ('c ! # 43) ; ('c ! # 44) ; ('c ! # 45) ; .Decls ) .
  op init : -> GlobalState .
  eq init = [ proctypes(none)
    procs(proc(pid(0) name('P0) k( body0 ~> .K ) local(nil) env(env0)))
    store(empty) network((0 |-> mq(3, nil))) lock(#none) active(0)
    nextLoc(0) nextPid(1) nextBCid(1) nextHCid(0) ] .
endm

rew init .
