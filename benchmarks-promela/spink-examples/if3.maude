*** if3.pml: nested if, 1 proc (hand-built post-INIT [...]).
*** outer if selects y:=1 or (nested if -> y:=3); y:=2 guard (x!=0) never holds.
*** Expected: yIs2 => No solution (safety) ; yIs1, yIs3 => solution.
*** Constructs: nested if, guard blocking.

load ../../semantics/promela-semantics.maude .

fmod BENCH-PROPS-IF3 is
  protecting PROMELA-CONFIG . protecting BOOL .
  op yIs1 : GlobalState -> Bool .  op yIs2 : GlobalState -> Bool .  op yIs3 : GlobalState -> Bool .
  eq yIs1([store((1 |-> # 1, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq yIs1(C:GlobalState) = false [owise] .
  eq yIs2([store((1 |-> # 2, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq yIs2(C:GlobalState) = false [owise] .
  eq yIs3([store((1 |-> # 3, STR:Map{Nat, PROMELA-Value})) CFG:KConfig]) = true .
  eq yIs3(C:GlobalState) = false [owise] .
endfm

mod BENCH-IF3 is
  protecting PROMELA-SEMANTICS . protecting BENCH-PROPS-IF3 .
  op env0 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  eq env0 = ((lval('x, 0) |-> loc(0)), (lval('y, 0) |-> loc(1))) .
  op body0 : -> Seq .
  eq body0 = ( if (:: ('x == # 0) ; ('y = # 1) ; .Decls)
                  (:: (if (:: ('x != # 0) ; ('y = # 2) ; .Decls)
                          (:: ('x < # 2) ; ('y = # 3) ; .Decls) fi) ; .Decls) fi ) ; .Decls .
  op init : -> GlobalState .
  eq init = [ proctypes(none)
    procs(proc(pid(0) name('P0) k( body0 ~> .K ) local(nil) env(env0)))
    store(((0 |-> # 0), (1 |-> # 0))) network(empty) lock(#none) active(0)
    nextLoc(2) nextPid(1) nextBCid(0) nextHCid(0) ] .
endm

search init =>* C:GlobalState such that yIs2(C:GlobalState) .
search init =>* C:GlobalState such that yIs1(C:GlobalState) .
search init =>* C:GlobalState such that yIs3(C:GlobalState) .
