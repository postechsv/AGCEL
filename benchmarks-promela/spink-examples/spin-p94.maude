*** spin-p94.pml: guard-block + arith, 2 procs (hand-built post-INIT [...]).
*** Deterministic outcome: B decrements state to 1, A guard passes, state := 3.
*** Expected (rew): store 0 |-> # 3.
*** Constructs: shared var, guard block.

load ../../semantics/promela-semantics.maude .

mod BENCH-SPIN-P94 is
  protecting PROMELA-SEMANTICS .
  op env0 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  op env1 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  eq env0 = (lval('state, 0) |-> loc(0)) .
  eq env1 = env0 .
  op body0 : -> Seq .
  op body1 : -> Seq .
  eq body0 = ( ('state == # 1) ; ('state = # 3) ; .Decls ) .
  eq body1 = ( ('state = 'state - # 1) ; .Decls ) .
  op init : -> GlobalState .
  eq init = [ proctypes(none)
    procs(proc(pid(0) name('A) k( body0 ~> .K ) local(nil) env(env0))
          proc(pid(1) name('B) k( body1 ~> .K ) local(nil) env(env1)))
    store(0 |-> # 2) network(empty) lock(#none) active(0 1)
    nextLoc(1) nextPid(2) nextBCid(0) nextHCid(0) ] .
endm

rew init .
