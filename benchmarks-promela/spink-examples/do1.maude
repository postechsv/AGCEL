*** do1.pml: do-loop with break, 1 proc (hand-built post-INIT [...]).
*** Deterministic: increment i until i>=n then break.
*** Expected (rew): store 1 |-> # 3 (i=3, loop exited).
*** Constructs: [load-do], [break], guard block.

load ../../semantics/promela-semantics.maude .

mod BENCH-DO1 is
  protecting PROMELA-SEMANTICS .
  op env0 : -> Map{PROMELA-LVal, PROMELA-Ref} .
  eq env0 = ((lval('n, 0) |-> loc(0)), (lval('i, 0) |-> loc(1))) .
  op body0 : -> Seq .
  eq body0 = ( do (:: ('i < 'n) ; ('i = 'i + # 1) ; .Decls)
                  (:: ('i >= 'n) ; break ; .Decls) od ) ; .Decls .
  op init : -> GlobalState .
  eq init = [ proctypes(none)
    procs(proc(pid(0) name('P0) k( body0 ~> .K ) local(nil) env(env0)))
    store(((0 |-> # 3), (1 |-> # 0))) network(empty) lock(#none) active(0)
    nextLoc(2) nextPid(1) nextBCid(0) nextHCid(0) ] .
endm

rew init .
