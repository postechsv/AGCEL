*** Offline code generator for the obs(Qid,Qid,Univ) action-binding hook.
*** Imports META-LEVEL only and refers to PROMELA-SEMANTICS by name via upModule,
*** so PROMELA object syntax and META-LEVEL never share a module.
*** Run (from semantics/):
***   MAUDE_LIB=. maude -no-banner -batch promela-rule-extract.maude
*** then save the printed String as promela-obs-generated.maude.

load promela-semantics.maude .

fmod PROMELA-RULE-EXTRACT is
  protecting META-LEVEL .

  vars L Q : Qid . vars T T' : Term . var TL : TermList . var V : Variable .
  var C : Constant . var AS : AttrSet . var CD : Condition . var RS : RuleSet .
  var QS : QidSet .

  op semMod : -> Module .
  eq semMod = upModule('PROMELA-SEMANTICS, false) .

  --- LHS of the rule labelled L (rl and crl forms)
  op lhsIn : Qid RuleSet -> Term .
  eq lhsIn(L, (rl T => T' [label(L) AS] .) RS) = T .
  eq lhsIn(L, (crl T => T' if CD [label(L) AS] .) RS) = T .
  op lhsOf : Qid -> Term .
  eq lhsOf(L) = lhsIn(L, getRls(semMod)) .

  --- variables occurring in a term
  op varsOf : TermList -> QidSet .
  eq varsOf(V) = V .
  eq varsOf(C) = none .
  eq varsOf(Q[TL]) = varsOf(TL) .
  eq varsOf((T, TL)) = varsOf(T) ; varsOf(TL) .
  eq varsOf(empty) = none .

  op lhsVars : Qid -> QidSet .
  eq lhsVars(L) = varsOf(lhsOf(L)) .

  --- selection policy: identifier-valued bindings only. Term-valued bindings
  --- such as BS, K, VL, ML, ENV, STR, NET are excluded: lifting them collapses
  --- the abstraction back to concrete states.
  op pidVar : Qid -> Bool .
  eq pidVar(Q) = Q == 'PID or Q == 'PID1 or Q == 'PID2 .
  op idVar : Qid -> Bool .
  eq idVar(Q) = Q == 'C or Q == 'X or Q == 'L .

  op qs : Qid -> String .
  eq qs(Q) = "'" + string(Q) .
  op vs : Variable -> String .
  eq vs(V) = string(getName(V)) + ":" + string(getType(V)) .

  op genEq : Qid Variable -> String .
  ceq genEq(L, V) = "  eq obs(" + qs(L) + ", " + qs(getName(V)) + ", data(" + vs(V)
                    + ")) = " + qs(getName(V)) + " := data(tag(" + vs(V) + ")) .\n"
    if pidVar(getName(V)) .
  ceq genEq(L, V) = "  eq obs(" + qs(L) + ", " + qs(getName(V)) + ", data(" + vs(V)
                    + ")) = " + qs(getName(V)) + " := data(" + vs(V) + ") .\n"
    if idVar(getName(V)) .
  eq genEq(L, V) = "" [owise] .

  op genObsEqs : Qid QidSet -> String .
  eq genObsEqs(L, none) = "" .
  eq genObsEqs(L, V ; QS) = genEq(L, V) + genObsEqs(L, QS) .

  op genAll : RuleSet -> String .
  eq genAll(none) = "" .
  eq genAll((rl T => T' [label(L) AS] .) RS) = genObsEqs(L, varsOf(T)) + genAll(RS) .
  eq genAll((crl T => T' if CD [label(L) AS] .) RS) = genObsEqs(L, varsOf(T)) + genAll(RS) .

  op genModule : -> String .
  eq genModule =
    "*** GENERATED by promela-rule-extract.maude -- do not edit by hand.\n"
    + "*** obs(Qid,Qid,Univ) action-binding hook: lifts identifier-valued LHS\n"
    + "*** bindings (PID/PID1/PID2 through tag, C, X, L); every other binding falls\n"
    + "*** through to PROMELA-AGCEL's [owise] none. Requires PROMELA-AGCEL loaded.\n\n"
    + "mod PROMELA-OBS-GEN is\n  inc PROMELA-AGCEL .\n\n"
    + genAll(getRls(semMod)) + "endm\n" .
endfm

red lhsVars('fire) .
red lhsVars('send-push) .
red lhsVars('recv-pop) .
red lhsVars('assign-store) .
red lhsVars('hs-fire) .
red genObsEqs('recv-pop, lhsVars('recv-pop)) .
red genModule .
quit
