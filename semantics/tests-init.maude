load promela-semantics.maude .

mod TESTS-INIT is protecting PROMELA-SEMANTICS . endm

rew initT(#globals((int 'x[# 1] = # 0) ; .Decls)
  ~> #activeProctype('P, .Decls, (('x = # 1) ; ('x = # 2) ; .Decls))) .

search initT(#globals((int 'x[# 1] = # 0) ; .Decls)
  ~> #activeProctype('P, .Decls, ((if (:: ('x = # 1) ; .Decls) (:: ('x = # 2) ; .Decls) fi) ; .Decls)))
  =>* [ store((0 |-> # 1, STR:Map{Nat, PROMELA-Value})) CFG:KConfig ] .
search initT(#globals((int 'x[# 1] = # 0) ; .Decls)
  ~> #activeProctype('P, .Decls, ((if (:: ('x = # 1) ; .Decls) (:: ('x = # 2) ; .Decls) fi) ; .Decls)))
  =>* [ store((0 |-> # 2, STR:Map{Nat, PROMELA-Value})) CFG:KConfig ] .

rew initT(#globals((int 'n[# 1] = # 3) ; (int 'i[# 1] = # 0) ; .Decls)
  ~> #activeProctype('P, .Decls,
       ((do (:: ('i < 'n) ; ('i = 'i + # 1) ; .Decls) (:: ('i >= 'n) ; break ; .Decls) od) ; .Decls))) .

search initT(#globals((int 'x[# 1] = # 0) ; .Decls)
  ~> (chan 'c[# 1] =[ 3 ]of{ int })
  ~> #activeProctype('P0, .Decls, (('c ! # 42) ; .Decls))
  ~> #activeProctype('P1, .Decls, (('c ? 'x) ; .Decls)))
  =>* [ store((0 |-> # 42, STR:Map{Nat, PROMELA-Value})) CFG:KConfig ] .

search initT(#globals((int 'x[# 1] = # 0) ; .Decls)
  ~> (chan 'c[# 1] =[ 0 ]of{ int })
  ~> #activeProctype('P0, .Decls, (('c[# 0] ! # 42) ; .Decls))
  ~> #activeProctype('P1, .Decls, (('c[# 0] ? 'x) ; .Decls)))
  =>* [ store((0 |-> # 42, STR:Map{Nat, PROMELA-Value})) CFG:KConfig ] .

search initT(#globals((int 'f0[# 1] = # 0) ; (int 'f1[# 1] = # 0) ; (int 'turn[# 1] = # 0) ; (int 'x[# 1] = # 0) ; .Decls)
  ~> #activeProctype('P0, (int 'tmp ; .Decls), (('f0 = # 1) ; ('turn = # 1) ;
       (('f1 != # 1) || ('turn != # 1)) ; ('tmp = 'x + # 1) ; ('x = 'tmp) ; ('f0 = # 0) ; .Decls))
  ~> #activeProctype('P1, (int 'tmp ; .Decls), (('f1 = # 1) ; ('turn = # 0) ;
       (('f0 != # 1) || ('turn != # 0)) ; ('tmp = 'x + # 1) ; ('x = 'tmp) ; ('f1 = # 0) ; .Decls)))
  =>! [ store((3 |-> # 1, STR:Map{Nat, PROMELA-Value})) CFG:KConfig ] .
search initT(#globals((int 'f0[# 1] = # 0) ; (int 'f1[# 1] = # 0) ; (int 'turn[# 1] = # 0) ; (int 'x[# 1] = # 0) ; .Decls)
  ~> #activeProctype('P0, (int 'tmp ; .Decls), (('f0 = # 1) ; ('turn = # 1) ;
       (('f1 != # 1) || ('turn != # 1)) ; ('tmp = 'x + # 1) ; ('x = 'tmp) ; ('f0 = # 0) ; .Decls))
  ~> #activeProctype('P1, (int 'tmp ; .Decls), (('f1 = # 1) ; ('turn = # 0) ;
       (('f0 != # 1) || ('turn != # 0)) ; ('tmp = 'x + # 1) ; ('x = 'tmp) ; ('f1 = # 0) ; .Decls)))
  =>! [ store((3 |-> # 2, STR:Map{Nat, PROMELA-Value})) CFG:KConfig ] .
