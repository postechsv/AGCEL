    =>
    [last(exec(decl-uch, tag(PID), prefix((chan X[# I]) ~> K, propKsize)))
     procs(proc(pid(PID) INNER-REST k(K) local((LOCAL, declLocal(PID, X)))
               env((ENV, envUch(X, 0, I - 1)))) PROC-REST)
    CFG-REST]
    if I > 0 .

  rl [freeze] :
    [last(LA:[Action]) procs(proc(pid(PID) k(#freeze ~> K) INNER-REST) PROC-REST)
    lock(#none) active(ACT) CFG-REST]
    =>
    [last(exec(freeze, tag(PID), prefix(#freeze ~> K, propKsize)))
     procs(proc(pid(PID) k(.K) INNER-REST) PROC-REST)
    lock(#frozen) active(nil) CFG-REST] .

  rl [load-seq] :
    [last(LA:[Action]) procs(proc(pid(PID) k((ST ; SL) ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]
    =>
    [last(exec(load-seq, tag(PID), prefix((ST ; SL) ~> K, propKsize)))
     procs(proc(pid(PID) k(load(LCK == @ PID, split(ST ; SL) ~> K)) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST] .

  rl [load-atomic] :
    [last(LA:[Action]) procs(proc(pid(PID) k(atomic{ SL } ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]
    =>
    [last(exec(load-atomic, tag(PID), prefix(atomic{ SL } ~> K, propKsize)))
     procs(proc(pid(PID) k(load(LCK == @ PID, atomic{ SL } ~> K)) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST] .

  rl [load-if] :
    [last(LA:[Action]) procs(proc(pid(PID) k(if OL fi ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]
    =>
    [last(exec(load-if, tag(PID), prefix(if OL fi ~> K, propKsize)))
     procs(proc(pid(PID) k(load(LCK == @ PID, if OL fi ~> K)) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST] .

  rl [load-do] :
    [last(LA:[Action]) procs(proc(pid(PID) k(do OL od ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]
    =>
    [last(exec(load-do, tag(PID), prefix(do OL od ~> K, propKsize)))
     procs(proc(pid(PID) k(load(LCK == @ PID, do OL od ~> K)) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST] .

  crl [load-basic] :
    [last(LA:[Action]) procs(proc(pid(PID) k(BS ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]
    =>
    [last(exec(load-basic, tag(PID), prefix(BS ~> K, propKsize)))
     procs(proc(pid(PID) k(load(LCK == @ PID, BS ~> K)) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]
    if not (BS :: Value) /\ not (BS :: Decl) .

  rl [load-goto] :
    [last(LA:[Action]) procs(proc(pid(PID) k(goto X ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]
    =>
    [last(exec(load-goto, tag(PID), prefix(goto X ~> K, propKsize)))
     procs(proc(pid(PID) k(load(LCK == @ PID, goto X ~> K)) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST] .

  rl [load-break] :
    [last(LA:[Action]) procs(proc(pid(PID) k(break ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]
    =>
    [last(exec(load-break, tag(PID), prefix(break ~> K, propKsize)))
     procs(proc(pid(PID) k(load(LCK == @ PID, break ~> K)) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST] .

  op #proctype : Id Decls Seq -> KLabel [ctor] .
  op #activeProctype : Id Decls Seq -> KLabel [ctor] .
  op #activeN : Int Id Decls Seq -> KLabel [ctor] .
  op #repeat : Int K -> KLabel [ctor] .

  rl [proctype] :
    [last(LA:[Action]) proctypes(PTS)
     procs(proc(pid(PID) k(#proctype(X, DECLS, SL) ~> K) INNER-REST) PROC-REST) CFG-REST]
    =>
    [last(exec(proctype, tag(PID), prefix(#proctype(X, DECLS, SL) ~> K, propKsize)))
     proctypes(proctype(procName(X) procParams(DECLS) procBody(SL) gotoMap(empty)) PTS)
     procs(proc(pid(PID) k(K) INNER-REST) PROC-REST) CFG-REST] .

  rl [active] :
    [last(LA:[Action]) procs(proc(pid(PID) k(#activeProctype(X, DECLS, SL) ~> K) INNER-REST) PROC-REST) CFG-REST]
    =>
    [last(exec(active, tag(PID), prefix(#activeProctype(X, DECLS, SL) ~> K, propKsize)))
     procs(proc(pid(PID) k(#proctype(X, DECLS, SL) ~> #run(X, nil) ~> K) INNER-REST) PROC-REST) CFG-REST] .

  rl [active-n] :
    [last(LA:[Action]) procs(proc(pid(PID) k(#activeN(N, X, DECLS, SL) ~> K) INNER-REST) PROC-REST) CFG-REST]
    =>
    [last(exec(active-n, tag(PID), prefix(#activeN(N, X, DECLS, SL) ~> K, propKsize)))
     procs(proc(pid(PID) k(#proctype(X, DECLS, SL) ~> #repeat(N, #run(X, nil)) ~> K) INNER-REST) PROC-REST) CFG-REST] .

  crl [repeat] :
    [last(LA:[Action]) procs(proc(pid(PID) k(#repeat(N, K1) ~> K) INNER-REST) PROC-REST) CFG-REST]
    =>
    [last(exec(repeat, tag(PID), prefix(#repeat(N, K1) ~> K, propKsize)))
     procs(proc(pid(PID) k(K1 ~> #repeat(N - 1, K1) ~> K) INNER-REST) PROC-REST) CFG-REST]
    if N > 0 .
  crl [repeat-done] :
    [last(LA:[Action]) procs(proc(pid(PID) k(#repeat(N, K1) ~> K) INNER-REST) PROC-REST) CFG-REST]
    =>
    [last(exec(repeat-done, tag(PID), prefix(#repeat(N, K1) ~> K, propKsize)))
     procs(proc(pid(PID) k(K) INNER-REST) PROC-REST) CFG-REST]
    if N <= 0 .

  op #globals : Decls -> KLabel [ctor] .
  rl [globals] :
    [last(LA:[Action]) procs(proc(pid(PID) k(#globals(D:Decl ; DECLS) ~> K) INNER-REST) PROC-REST) CFG-REST]
    =>
    [last(exec(globals, tag(PID), prefix(#globals(D:Decl ; DECLS) ~> K, propKsize)))
     procs(proc(pid(PID) k(D:Decl ~> #globals(DECLS) ~> K) INNER-REST) PROC-REST) CFG-REST] .
  rl [globals-done] :
    [last(LA:[Action]) procs(proc(pid(PID) k(#globals(.Decls) ~> K) INNER-REST) PROC-REST) CFG-REST]
    =>
    [last(exec(globals-done, tag(PID), prefix(#globals(.Decls) ~> K, propKsize)))
     procs(proc(pid(PID) k(K) INNER-REST) PROC-REST) CFG-REST] .

  op canStep : GlobalState -> Bool .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k((@[ BS ~> KLOCAL ] BREST) ~> KGLOBAL) local(LOCAL) env(ENV)) PROC-REST)
    store(STR) network(NET) lock(LCK) nextPid(NPID) CFG-REST]) = true
    if (LCK == #none or LCK == @ PID)
       /\ isExec(BS, ENV, STR, NET, NPID) .
  ceq canStep(
    [procs(proc(pid(PID1) INNER-REST k((@[ X[# I] ! EL1 ~> K1 ] BREST1) ~> KGLOBAL1) local(LOCAL) env(ENV1))
          proc(pid(PID2) name(NAME2) k((@[ X[# J] ? EL2 ~> K2 ] BREST2) ~> KGLOBAL2) local(LOCAL2) env(ENV2))
          PROC-REST)
    store(STR) network(NET) lock(LCK) nextPid(NPID) CFG-REST]) = true
    if (LCK == #none or LCK == @ PID1 or LCK == @ PID2)
       /\ eval(X[# I], ENV1, STR, NET) ==HChan eval(X[# J], ENV2, STR, NET)
       /\ matchMsg(EL2, evalList(EL1, ENV1, STR, NET)) .
  eq canStep(
    [procs(proc(pid(PID) k(#rel ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]) = true .
  ceq canStep(
    [procs(proc(pid(PID) k(#toss(I) ~> KI:KLabel ~> K) INNER-REST) PROC-REST)
    CFG-REST]) = true
    if KI:KLabel =/= #rel .
  eq canStep(
    [procs(proc(pid(PID) k(#toss(I) ~> #rel ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]) = true .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k(#assign(X, E, E2) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    store(STR) network(NET) CFG-REST]) = true
    if not(E :: Value) .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k(#assign(X, V, E) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    store(STR) network(NET) CFG-REST]) = true
    if not(E :: Value) .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k(#assign(X, VIDX, V2) ~> K) local(LOCAL)
               env(((lval(X, I) |-> loc(L)), ENV))) PROC-REST)
    store(((L |-> VOLD), STR)) CFG-REST]) = true
    if # I := VIDX .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k(#assign(X, VIDX, # CH) ~> K) local(LOCAL)
               env(((lval(X, I) |-> CH2), ENV))) PROC-REST)
    CFG-REST]) = true
    if # I := VIDX .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k(#send(VR, EL) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    store(STR) network(NET) CFG-REST]) = true
    if not(VR :: Value) .
  eq canStep(
    [procs(proc(pid(PID) INNER-REST k(#send(# ch(C), EL) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    store(STR) network(((C |-> mq(S, ML)), NET)) CFG-REST]) = true .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k(#recv(VR, EL) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    store(STR) network(NET) CFG-REST]) = true
    if not(VR :: Value) .
  eq canStep(
    [procs(proc(pid(PID) k(#recv(# ch(C), EL) ~> K) INNER-REST) PROC-REST)
    network(((C |-> mq(S, (m(VL), ML))), NET)) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(#recvMsg(nil, m(nil)) ~> K) INNER-REST) PROC-REST)
    CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(#recvMsg((V, EL), m((V, VL))) ~> K) INNER-REST) PROC-REST)
    CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(#recvMsg((X[# I], EL), m((V, VL))) ~> K) INNER-REST) PROC-REST)
    CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(#recvMsg((X, EL), m((V, VL))) ~> K) INNER-REST) PROC-REST)
    CFG-REST]) = true .
  eq canStep(
    [proctypes(proctype(procName(NAME) gotoMap(((X |-> gotoCtx(B, KCONT)), GMAP)) INNER-REST) PT-REST:KConfig)
    procs(proc(pid(PID) name(NAME) k(goto X ~> K) local(LOCAL) env(ENV)) PROC-REST)
    lock(LCK) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(break ~> do OL od ~> K) INNER-REST) PROC-REST)
    CFG-REST]) = true .
  ceq canStep(
    [procs(proc(pid(PID) k(break ~> KI:KLabel ~> K) INNER-REST) PROC-REST)
    CFG-REST]) = true
    if not(isDoLoop(KI:KLabel)) .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k(#run(X, EL) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    store(STR) network(NET) CFG-REST]) = true
    if not(EL :: ValueList) .
  eq canStep(
    [proctypes(proctype(procName(X) procParams(DECLS) procBody(BODY) INNER-REST) PT-REST:KConfig)
    procs(proc(pid(PID) name(NAME) k(#run(X, VL) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    active(ACT) nextPid(NPID) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) INNER-REST k(#wait ~> K) local(LOCAL) env(ENV))
          proc(pid(PID2) name(NAME2) k(#done ~> K2) local(LOCAL2) env(ENV2))
          PROC-REST)
    CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(#init(.Decls, VL) ~> K) INNER-REST) PROC-REST)
    CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(#init((PT X ; DECLS), nil) ~> K) INNER-REST) PROC-REST)
    CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(#init((PT X ; DECLS), (V, VL)) ~> K) INNER-REST) PROC-REST)
    CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k((int X[# I]) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k((int X) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k((bool X[# I]) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k((bool X) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k((T X = V) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k((PT X[# I] = V) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    store(STR) nextLoc(J) CFG-REST]) = true
    if I > 0 .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k((chan X[# I] =[ CAP ]of{ TS }) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    network(NET) nextBCid(NBC) CFG-REST]) = true
    if I > 0 /\ CAP > 0 .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k((chan X[# I] =[ 0 ]of{ TS }) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    nextHCid(NHC) CFG-REST]) = true
    if I > 0 .
  ceq canStep(
    [procs(proc(pid(PID) INNER-REST k((chan X[# I]) ~> K) local(LOCAL) env(ENV)) PROC-REST)
    CFG-REST]) = true
    if I > 0 .
  eq canStep(
    [procs(proc(pid(PID) k(#freeze ~> K) INNER-REST) PROC-REST)
    lock(#none) active(ACT) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k((ST ; SL) ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(atomic{ SL } ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(if OL fi ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(do OL od ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]) = true .
  ceq canStep(
    [procs(proc(pid(PID) k(BS ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]) = true
    if not (BS :: Value) /\ not (BS :: Decl) .
  eq canStep(
    [procs(proc(pid(PID) k(goto X ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(break ~> K) INNER-REST) PROC-REST)
    lock(LCK) CFG-REST]) = true .
  eq canStep(
    [proctypes(PTS)
     procs(proc(pid(PID) k(#proctype(X, DECLS, SL) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(#activeProctype(X, DECLS, SL) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(#activeN(N, X, DECLS, SL) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true .
  ceq canStep(
    [procs(proc(pid(PID) k(#repeat(N, K1) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true
    if N > 0 .
  ceq canStep(
    [procs(proc(pid(PID) k(#repeat(N, K1) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true
    if N <= 0 .
  eq canStep(
    [procs(proc(pid(PID) k(#globals(D:Decl ; DECLS) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true .
  eq canStep(
    [procs(proc(pid(PID) k(#globals(.Decls) ~> K) INNER-REST) PROC-REST) CFG-REST]) = true .
  eq canStep(GS:GlobalState) = false [owise] .

  op initT : K -> GlobalState .
  eq initT(K) = [ last(noAct) proctypes(none)
    procs(proc(pid(-1) name('Main) k(K) local(nil) env(empty)))
    store(empty) network(empty) lock(#none) active(nil)
    nextLoc(0) nextPid(0) nextBCid(0) nextHCid(0) ] .
endm
